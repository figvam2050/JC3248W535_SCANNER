#include <Arduino.h>
#include <Arduino_GFX_Library.h>
#include <Wire.h>

// --- Піни дисплея JC3248W535C (QSPI) ---
#define LCD_CS    45
#define LCD_SCLK  47
#define LCD_D0    21
#define LCD_D1    48
#define LCD_D2    40
#define LCD_D3    39
#define LCD_BL    1

// --- Піни та адреса тачскріна (AXS15231B Touch) ---
#define TOUCH_ADDR       0x3B
#define TOUCH_SDA        4
#define TOUCH_SCL        8
#define TOUCH_RST_PIN    12
#define TOUCH_INT_PIN    11
#define TOUCH_I2C_CLOCK  400000
#define AXS_MAX_TOUCH    1

// Створення QSPI шини та драйвера дисплея
Arduino_DataBus *bus = new Arduino_ESP32QSPI(LCD_CS, LCD_SCLK, LCD_D0, LCD_D1, LCD_D2, LCD_D3);
Arduino_GFX *panel = new Arduino_AXS15231B(bus, GFX_NOT_DEFINED, 0 /* rotation */, false /* IPS */, 320, 480);

// Використання Canvas (фреймбуфера) у PSRAM для усунення артефактів/мерехтіння QSPI
Arduino_Canvas *gfx = new Arduino_Canvas(320, 480, panel, 0, 0, 0);

bool getTouchPoint(uint16_t &x, uint16_t &y) {
  uint8_t data[AXS_MAX_TOUCH * 6 + 2] = {0};
  const uint8_t read_cmd[11] = {
    0xb5, 0xab, 0xa5, 0x5a, 0x00, 0x00,
    (uint8_t)((AXS_MAX_TOUCH * 6 + 2) >> 8),
    (uint8_t)((AXS_MAX_TOUCH * 6 + 2) & 0xff),
    0x00, 0x00, 0x00
  };

  Wire.beginTransmission(TOUCH_ADDR);
  Wire.write(read_cmd, sizeof(read_cmd));
  if (Wire.endTransmission() != 0) return false;

  if (Wire.requestFrom((uint8_t)TOUCH_ADDR, (size_t)sizeof(data)) != sizeof(data)) return false;

  for (size_t i = 0; i < sizeof(data); i++) {
    data[i] = Wire.read();
  }

  if (data[1] > 0 && data[1] <= AXS_MAX_TOUCH) {
    x = ((data[2] & 0x0F) << 8) | data[3];
    y = ((data[4] & 0x0F) << 8) | data[5];
    return true;
  }
  return false;
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println(">>> JC3248W535C Display Initializing <<<");

  // Підсвічування
  pinMode(LCD_BL, OUTPUT);
  digitalWrite(LCD_BL, HIGH);

  // Скидання та ініціалізація тачу
  pinMode(TOUCH_INT_PIN, INPUT_PULLUP);
  pinMode(TOUCH_RST_PIN, OUTPUT);
  digitalWrite(TOUCH_RST_PIN, LOW);
  delay(20);
  digitalWrite(TOUCH_RST_PIN, HIGH);
  delay(100);

  Wire.begin(TOUCH_SDA, TOUCH_SCL);
  Wire.setClock(TOUCH_I2C_CLOCK);

  // Ініціалізація графіки
  gfx->begin();
  gfx->fillScreen(RGB565_BLACK);

  // Перевірка PSRAM
  size_t psramTotal = ESP.getPsramSize();
  size_t psramFree = ESP.getFreePsram();

  gfx->setTextColor(RGB565_CYAN);
  gfx->setTextSize(2);
  gfx->setCursor(20, 30);
  gfx->println("JC3248W535C 3.5\"");

  gfx->setTextColor(RGB565_WHITE);
  gfx->setTextSize(1);
  gfx->setCursor(20, 70);
  gfx->printf("Resolution: 320x480 (IPS QSPI)\n");
  gfx->setCursor(20, 90);
  gfx->printf("Flash Size: %d MB\n", ESP.getFlashChipSize() / (1024 * 1024));
  gfx->setCursor(20, 110);
  gfx->printf("PSRAM: Total %d KB, Free %d KB\n", (int)(psramTotal / 1024), (int)(psramFree / 1024));

  gfx->drawRect(10, 140, 300, 320, RGB565_DARKGREY);
  gfx->setCursor(30, 160);
  gfx->setTextColor(RGB565_GREEN);
  gfx->println("Touch anywhere inside box:");

  gfx->flush();
}

uint16_t lastX = 0, lastY = 0;
bool wasTouched = false;

void loop() {
  uint16_t x, y;
  if (getTouchPoint(x, y)) {
    Serial.printf("Touch at X: %d, Y: %d\n", x, y);

    // Малюємо крапку
    gfx->fillCircle(x, y, 4, RGB565_YELLOW);

    // Оновлюємо статус зверху
    gfx->fillRect(20, 185, 260, 20, RGB565_BLACK);
    gfx->setCursor(20, 185);
    gfx->setTextColor(RGB565_YELLOW);
    gfx->setTextSize(2);
    gfx->printf("X: %03d  Y: %03d", x, y);

    gfx->flush();
    wasTouched = true;
    lastX = x;
    lastY = y;
  }
  delay(10);
}

